@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  color-scheme: dark;
  --callsignal-ink: #08111f;
  --callsignal-slate: #102235;
  --callsignal-panel: rgba(8, 17, 31, 0.82);
  --callsignal-text: #e5eefb;
  --callsignal-muted: #86a4c7;
  --callsignal-blue: #42a5ff;
  --callsignal-green: #3be0a2;
  --callsignal-warn: #fbbf24;
  --callsignal-red: #fb7185;
}

html, body {
  min-height: 100%;
  background:
    radial-gradient(circle at top left, rgba(66,165,255,0.20), transparent 24%),
    radial-gradient(circle at 85% 15%, rgba(59,224,162,0.14), transparent 20%),
    linear-gradient(180deg, #07101d 0%, #050a13 100%);
  color: var(--callsignal-text);
  font-family: 'Avenir Next', 'Trebuchet MS', 'Segoe UI', sans-serif;
}

body {
  margin: 0;
}

a {
  color: inherit;
  text-decoration: none;
}

.panel {
  @apply rounded-3xl border border-slate-800/80 bg-slate-950/80 shadow-glow backdrop-blur-xl;
}

.soft-chip {
  @apply inline-flex items-center gap-2 rounded-full border border-slate-700/80 bg-slate-900/80 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-slate-300;
}
